# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated Telegram chat ids allowed to use the bot (Meera's notes channel)
ALLOWED_CHAT_IDS=
# Random string Telegram sends back on every webhook call (generate: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# Supabase backend
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Personal access token for deploying (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# Optional
# GEMINI_SCREEN_MODEL=gemini-3.7-flash
# GEMINI_DRAFT_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
# PASS_SCORE=6
