# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Random string Telegram sends back on every webhook call (generate: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat ids allowed to use the bot (Meera's). The bot tells you the id on first message.
ALLOWED_CHAT_IDS=

# Optional
# GEMINI_SCREEN_MODEL=gemini-2.5-flash
# GEMINI_DRAFT_MODEL=gemini-2.5-flash
# PASS_SCORE=6
# Draft storage on Vercel: Upstash Redis (Vercel Marketplace sets these automatically)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
